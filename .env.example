# Copy to .env and adjust.
DOMAIN=snaizer.example.com
# Optional: force the public URL (otherwise derived from Caddy's forwarded headers)
PUBLIC_URL=
# 2222 (default) or 22 once the host's own sshd has moved elsewhere
SSH_PUBLIC_PORT=2222
SSH_MAX_SESSIONS=50
SSH_MAX_PER_IP=5
SSH_IDLE_TIMEOUT=900
SSH_MAX_SESSION_SECONDS=3600
WEB_MAX_SESSIONS=50
