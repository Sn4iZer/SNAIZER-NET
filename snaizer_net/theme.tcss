/* SNAIZER//NET theme.
 * Colors come only from $neon-* variables (see themes.py), so swapping the
 * Textual theme swaps the whole palette live.
 *
 * Layering: chrome (status, sidebar, hints) = $neon-panel, content = $neon-bg.
 * Borders are soft (round, tinted) at rest and go full-neon on focus/hover,
 * so the bright color always marks where the user's attention is.
 */

* {
    scrollbar-color: $neon-magenta 60%;
    scrollbar-color-hover: $neon-cyan;
    scrollbar-color-active: $neon-yellow;
    scrollbar-background: $neon-bg;
    scrollbar-background-hover: $neon-bg;
    scrollbar-background-active: $neon-bg;
    scrollbar-size-vertical: 1;
}

Screen {
    background: $neon-bg;
    color: $neon-text;
}

/* ---------------------------------------------------------------- boot -- */

#boot-wrap {
    padding: 1 2;
}

#boot-logo {
    margin-bottom: 1;
}

#boot-log {
    height: 1fr;
}

#boot-progress,
#boot-hint {
    height: 1;
}

/* --------------------------------------------------------------- login -- */

LoginScreen {
    align: center middle;
}

#login-wrap {
    width: 76;
    height: auto;
    align-horizontal: center;
}

#login-title,
#login-title-touch {
    width: auto;
    margin: 1 0;
}

#login-box {
    width: 60;
    height: auto;
    padding: 0 2;
    background: $neon-bg;
    border: round $neon-cyan;
}

#login-box.-denied {
    border: round $neon-danger;
    background: $neon-danger 10%;
}

#login-box.-granted {
    border: round $neon-green;
}

.login-label {
    margin-top: 1;
}

#login-status {
    height: auto;
    min-height: 1;
    margin-top: 1;
}

#login-help {
    height: 1;
}

Input {
    background: $neon-bg;
    color: $neon-text;
    border: round $neon-dim 60%;
}

Input:focus {
    border: round $neon-magenta;
}

Input > .input--placeholder {
    color: $neon-dim;
}

Input > .input--cursor {
    background: $neon-magenta;
    color: $neon-bg;
}

#decrypt {
    margin-top: 1;
}

#granted {
    margin-top: 1;
}

/* ---------------------------------------------------------------- main -- */

#status {
    dock: top;
    height: 2;
    padding: 0 1;
    background: $neon-panel;
    border-bottom: hkey $neon-magenta 60%;
}

#key-hints {
    dock: bottom;
    height: 2;
    padding: 0 1;
    background: $neon-panel;
    border-top: hkey $neon-dim 40%;
}

MainScreen.-narrow #status,
MainScreen.-narrow #key-hints {
    height: 1;
    border: none;
}

#tabstrip {
    display: none;
    height: 1;
    background: $neon-panel;
}

MainScreen.-narrow #tabstrip {
    display: block;
}

MainScreen.-narrow #sidebar {
    display: none;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 24;
    padding: 1 0;
    background: $neon-panel;
    border-right: vkey $neon-dim 40%;
}

.nav-header {
    padding: 0 2;
    margin-bottom: 1;
}

.nav-item {
    padding: 0 1;
    color: $neon-dim;
    border-left: blank;
}

#tabstrip .nav-item {
    width: auto;
    padding: 0 1;
    border-left: none;
}

.nav-item:hover {
    color: $neon-text;
    background: $neon-dim 15%;
}

.nav-item.-admin {
    color: $neon-yellow;
}

.nav-item.-active {
    color: $neon-cyan;
    background: $neon-cyan 12%;
    border-left: outer $neon-cyan;
    text-style: bold;
}

#tabstrip .nav-item.-active {
    color: $neon-bg;
    background: $neon-cyan;
    border-left: none;
}

/* neon pulse: MainScreen toggles -pulse a couple of times per second */
MainScreen.-pulse .nav-item.-active {
    border-left: outer $neon-magenta;
}

MainScreen.-pulse #tabstrip .nav-item.-active {
    background: $neon-magenta;
    border-left: none;
}

MainScreen.-pulse #dossier {
    border: round $neon-magenta;
}

.nav-spacer {
    height: 1fr;
}

.nav-footer {
    height: auto;
    padding: 0 2;
}

#pane {
    width: 1fr;
    padding: 1 2 0 2;
    background: $neon-bg;
}

MainScreen.-narrow #pane {
    padding: 0 1;
}

/* heading: "◢◤ ~/section" + one plain sentence, ruled off from the content */
#section-head {
    height: auto;
    margin-bottom: 1;
    border-bottom: hkey $neon-cyan 35%;
}

#section-title {
    height: 1;
}

#section-blurb {
    height: 1;
    padding-left: 3;
}

#switcher {
    height: 1fr;
}

.section {
    height: 1fr;
}

.caption {
    margin-bottom: 1;
    color: $neon-dim;
}

/* ledger: yellow date column, a rule, then the entry (education, experience).
 * The rule brightens on hover, like every other border in the HUD. */
.ledger {
    height: auto;
    margin-bottom: 1;
}

.ledger-when {
    width: 14;
    padding-right: 2;
    text-align: right;
}

.ledger-body {
    width: 1fr;
    padding-left: 2;
    border-left: vkey $neon-dim 40%;
}

.ledger:hover .ledger-body {
    border-left: vkey $neon-cyan;
}

MainScreen.-narrow .ledger-when {
    width: 13;
    padding-right: 1;
}

/* every row counts at 80x24: the key-hint bar already explains each section */
MainScreen.-narrow #section-blurb {
    display: none;
}

MainScreen.-narrow #section-head {
    margin-bottom: 0;
}

/* skills */

.group-heading {
    height: 1;
}

.skill-group {
    height: auto;
    margin-bottom: 1;
    padding-left: 2;
}

/* profile: the handle is the hero, everything else stays quiet */

#profile-handle {
    margin-bottom: 1;
}

#profile-name {
    margin-bottom: 1;
}

#bio {
    max-width: 78;
    margin-bottom: 1;
}

#profile-now {
    height: auto;
    margin-bottom: 1;
}

.now-row {
    height: auto;
}

.now-label {
    width: 11;
}

.now-value {
    width: 1fr;
}

/* the file you shouldn't open: heavy red frame, slow flicker (-dim) */
#classified {
    width: auto;
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: heavy $neon-danger;
}

#classified.-dim {
    border: heavy $neon-danger 35%;
}

#classified:hover,
#classified:focus {
    background: $neon-danger 18%;
    border: heavy $neon-danger;
}

#profile-stats {
    height: auto;
    padding: 0 1;
    background: $neon-panel;
    border-top: hkey $neon-magenta 60%;
}

.stat {
    width: auto;
    margin-right: 4;
}

#sensor-panel {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: $neon-bg;
    border-top: hkey $neon-green 45%;
    border-title-color: $neon-green;
    border-title-style: bold;
}

.sensor-row {
    height: 1;
}

.sensor-label {
    width: 14;
}

.sensor-value {
    width: 10;
    text-align: right;
}

Sparkline {
    width: 1fr;
}

Sparkline > .sparkline--max-color {
    color: $neon-cyan;
}

Sparkline > .sparkline--min-color {
    color: $neon-magenta 50%;
}

#scanline {
    color: $neon-cyan;
}

/* timeline */

#timeline-body {
    padding: 0 1;
}

/* projects */

#project-list {
    width: 40%;
    height: 1fr;
    margin-right: 1;
    background: $neon-bg;
    border: round $neon-dim 60%;
    border-title-color: $neon-cyan;
    border-title-style: bold;
    border-subtitle-color: $neon-dim;
}

#project-list:focus {
    border: round $neon-cyan;
}

#project-list > ListItem {
    background: $neon-bg;
    color: $neon-text;
}

#project-list > ListItem Label {
    width: 1fr;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#project-list > ListItem.-highlight {
    background: $neon-magenta 20%;
}

#project-list:focus > ListItem.-highlight {
    color: $neon-cyan;
    background: $neon-cyan 15%;
    text-style: bold;
}

#dossier-scroll {
    width: 1fr;
    height: 1fr;
}

#dossier {
    height: auto;
    padding: 1 2;
    background: $neon-bg;
    border: round $neon-danger;
    border-title-color: $neon-danger;
    border-title-style: bold;
    border-subtitle-color: $neon-dim;
}

MainScreen.-narrow ProjectsSection {
    layout: vertical;
}

MainScreen.-narrow #project-list {
    width: 1fr;
    height: 7;
    margin-right: 0;
}

/* awards */

#awards-row {
    height: auto;
}

.trophy {
    width: 15;
    margin-right: 3;
    color: $neon-yellow;
}

MainScreen.-narrow .trophy {
    display: none;
}

#awards-cards {
    width: 1fr;
    height: auto;
}

/* the frame encodes the placing: 1st is heavy and yellow, others soft */
.award-card {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: round $neon-dim 60%;
    border-title-color: $neon-text;
    border-title-style: bold;
    border-subtitle-color: $neon-yellow;
}

.award-card.-first {
    border: heavy $neon-yellow 70%;
    border-title-color: $neon-yellow;
}

.award-card:hover {
    border: round $neon-cyan;
}

.award-card.-first:hover {
    border: heavy $neon-yellow;
}

/* contact */

.contact-row {
    height: auto;
}

.contact-label {
    width: 10;
}

.contact-value {
    width: 1fr;
}

#contact-actions {
    height: auto;
    margin: 1 0;
}

#contact-actions Button {
    width: auto;
    min-width: 0;
    margin-right: 2;
    padding: 0 1;
    color: $neon-cyan;
    background: $neon-panel;
    text-style: bold;
}

#contact-actions Button:hover,
#contact-actions Button:focus {
    color: $neon-bg;
    background: $neon-cyan;
}

#contact-actions #decrypt-phone {
    color: $neon-magenta;
}

#contact-actions #decrypt-phone:hover,
#contact-actions #decrypt-phone:focus {
    color: $neon-bg;
    background: $neon-magenta;
}

/* terminal */

TerminalSection {
    height: 1fr;
}

#fake-shell {
    height: 1fr;
    padding: 0 1;
    background: $neon-bg;
    border: round $neon-green 60%;
}

#fake-shell:focus-within {
    border: round $neon-green;
}

#shell-scroll {
    height: 1fr;
}

#shell-prompt-row {
    height: 1;
}

#shell-prompt {
    width: auto;
}

#shell-input,
#shell-input:focus {
    width: 1fr;
    height: 1;
    padding: 0;
    border: none;
    background: $neon-bg;
}

/* black-ice */

.skull {
    width: auto;
    color: $neon-danger;
}

.blackice-title {
    margin: 1 0;
}

.blackice-body {
    padding-left: 2;
    border-left: vkey $neon-danger 60%;
}

/* ----------------------------------------------- classified walkthrough -- */
/* A different world: red is the only accent; the HUD chrome is gone. */

OverwatchScreen {
    background: $neon-bg;
}

OverwatchScreen.-alarm {
    background: $neon-danger 40%;
}

#ow-header {
    dock: top;
    height: 3;
    padding: 0 2;
    border-bottom: hkey $neon-danger 60%;
}

#ow-footer {
    dock: bottom;
    height: 3;
    padding: 0 2;
    border-top: hkey $neon-danger 60%;
}

#ow-progress,
#ow-controls {
    height: 1;
}

.ow-control {
    width: auto;
    margin-right: 3;
}

.ow-control:hover {
    background: $neon-cyan 15%;
}

/* phones: four equal tap zones, two rows tall */
App.-pocket #ow-footer {
    height: 4;
    padding: 0 1;
}

App.-pocket #ow-controls {
    height: 2;
}

App.-pocket .ow-control {
    width: 1fr;
    height: 2;
    margin: 0;
    content-align: center middle;
}

OverwatchScreen.-breach #ow-header,
OverwatchScreen.-breach #ow-footer {
    display: none;
}

#ow-stage-wrap {
    height: 1fr;
}

#ow-stage {
    height: 1fr;
    padding: 1 2;
}

OverwatchScreen.-short #ow-stage {
    padding: 0 2;
}

#ow-stage.-ending {
    margin: 1 2;
    padding: 1 3;
    border: heavy $neon-danger;
    background: $neon-danger 8%;
}

/* ------------------------------------------------------------ overlays -- */

HelpScreen {
    align: center middle;
    background: $neon-bg 70%;
}

#help-box {
    width: auto;
    max-width: 78;
    height: auto;
    padding: 1 2;
    background: $neon-panel;
    border: round $neon-magenta;
}

#help-box Static {
    width: auto;
}

MatrixScreen {
    background: $neon-bg;
}

#rain-caption {
    dock: bottom;
    height: 1;
}

#rain-caption Static {
    width: auto;
}

TooSmallScreen {
    align: center middle;
    background: $neon-bg;
}

#too-small {
    width: auto;
    padding: 1 2;
    text-align: center;
    border: round $neon-danger;
}

/* ---------------------------------------------------------------- pocket -- */
/* Phone-sized terminals (App.-pocket, under 64 columns): one column, big tap
 * targets, a bottom dock instead of keyboard hints. Desktop rules above stay
 * untouched; everything here only narrows or stacks them. */

.pocket-only {
    display: none;
}

App.-pocket .pocket-only {
    display: block;
}

App.-pocket .desktop-only {
    display: none;
}

/* navigation: dock + menu replace the tab strip and key hints */

#dock {
    display: none;
    dock: bottom;
    height: 4;
    background: $neon-panel;
    border-top: hkey $neon-magenta 60%;
}

App.-pocket #dock {
    display: block;
}

App.-pocket #tabstrip,
App.-pocket #key-hints {
    display: none;
}

.dock-button {
    width: 1fr;
    height: 3;
    content-align: center middle;
}

.dock-button:hover {
    background: $neon-cyan 12%;
}

#dock-menu {
    border-left: vkey $neon-dim 30%;
    border-right: vkey $neon-dim 30%;
}

MenuScreen {
    background: $neon-bg 92%;
}

#menu-box {
    margin: 1 1;
    padding: 0 1;
    background: $neon-panel;
    border: round $neon-magenta;
}

#menu-head {
    height: 1;
    margin-bottom: 1;
}

#menu-title {
    width: 1fr;
}

.menu-close {
    width: auto;
    height: 1;
}

.menu-close .menu-item-title,
.menu-action .menu-item-title {
    width: auto;
}

.menu-item {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    border-left: outer $neon-dim 30%;
}

.menu-item-title,
.menu-item-note {
    height: auto;
}

.menu-item-note {
    padding-left: 3;
}

.menu-item:hover,
.menu-item.-active {
    background: $neon-cyan 12%;
    border-left: outer $neon-cyan;
}

.menu-item.-admin {
    border-left: outer $neon-yellow 60%;
}

#menu-actions {
    height: auto;
    margin-bottom: 1;
}

.menu-action {
    width: 1fr;
    height: 3;
    align: center middle;
    border: round $neon-dim 40%;
}

.menu-action:hover {
    border: round $neon-cyan;
}

/* boot + login */

App.-pocket #boot-wrap {
    padding: 1 1;
}

#login-wrap,
#login-box {
    max-width: 100%;
}

App.-pocket #login-wrap {
    width: 100%;
    padding: 0 1;
}

App.-pocket #login-box {
    width: 100%;
    padding: 0 1;
}



/* content */

App.-pocket #pane {
    padding: 0 1;
}

App.-pocket .ledger {
    layout: vertical;
}

App.-pocket .ledger-when {
    width: auto;
    padding: 0;
    text-align: left;
}

App.-pocket .ledger-body {
    padding-left: 1;
}

App.-pocket .skill-group {
    padding-left: 0;
}

#classified {
    max-width: 100%;
}

App.-pocket #profile-stats {
    layout: grid;
    grid-size: 2;
    grid-gutter: 0 1;
}

App.-pocket .stat {
    width: 1fr;
    margin-right: 0;
}

App.-pocket #dossier {
    padding: 0 1;
}

App.-pocket #contact-actions {
    layout: vertical;
}

App.-pocket #contact-actions Button {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
    content-align: center middle;
    border: round $neon-cyan 40%;
}

App.-pocket #contact-actions #decrypt-phone {
    border: round $neon-magenta 60%;
}

App.-pocket .contact-row {
    layout: vertical;
    margin-bottom: 1;
}

App.-pocket .contact-label,
App.-pocket .contact-value {
    width: 100%;
}

App.-pocket #help-box {
    width: 100%;
    margin: 0 1;
}
